# FXNet lurker — secrets for docker-compose.fxnet.yml.
#
#   cp .env.fxnet.example .env.fxnet
#   # fill in both values with long random strings, then:
#   docker compose -f docker-compose.fxnet.yml up -d
#
# Non-secret config (the network lock, WebAuthn RP, etc.) lives inline in
# docker-compose.fxnet.yml — only the secrets belong here.

# Shared secret the FXNet website presents to the provisioning API
# (POST /api/provision/users). Must match LURKER_PROVISION_SECRET in the
# website's .env. Generate with: openssl rand -hex 32
LURKER_PROVISION_SECRET=

# Signs the session cookie. If unset, lurker generates one on first boot and
# persists it to data/session-secret.key; set it explicitly to control rotation
# or supply from a secrets manager. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared secret for WEBIRC real-IP forwarding. Must match the password on the
# InspIRCd <gateway type="webirc"> block that trusts this lurker host. When set
# (with LURKER_TRUST_PROXY on), each user's real browser IP is forwarded to the
# IRCd so they're individually attributable behind the shared gateway IP.
# Generate with: openssl rand -hex 32
LURKER_WEBIRC_PASSWORD=
